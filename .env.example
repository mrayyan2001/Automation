APP_ENV=dev
JWT_SECRET=
HTTP_SERVER_HOST=0.0.0.0
HTTP_SERVER_PORT=8000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_SENDER=your-address@gmail.com
SMTP_STARTTLS=true
SMTP_TIMEOUT=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Citus PostgreSQL (development)
CITUS_PORT=5432
CITUS_EXTERNAL_PORT=5432
CITUS_USER=postgres
CITUS_PASSWORD=automation
CITUS_DATABASE=postgres
CITUS_CONNECT_TIMEOUT_SECONDS=5
CITUS_MIN_CONNECTIONS=1
CITUS_MAX_CONNECTIONS=10
